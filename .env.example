# ==================================================
# SINGLE-SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==================================================

# Supabase Database & Auth (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server & JWT
PORT=3000
JWT_SECRET=your-jwt-secret-key-min-32-chars

# File Storage - Cloudinary (Future Modules)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway - Razorpay (Future Modules)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMS Gateway (Future Modules)
SMS_API_KEY=
SMS_API_SECRET=

# WhatsApp Business API (Future Modules)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email / SMTP (Future Modules)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Gemini API (if needed for AI enhancements)
GEMINI_API_KEY=
APP_URL=http://localhost:3000

